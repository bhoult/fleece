// flam3's finishing (rect.c, filters.c, palettes.c) for one frame:
// - log density: each pixel's t = k1 ln(1 + hits k2), colour = average
//   palette colour * t;
// - density estimation: every pixel is spread with a gaussian whose width
//   shrinks with its hit count (cmax / (k + 1)^curve), done here as a gather
//   over a shared-memory tile;
// - gamma with the linear range near zero, vibrancy, highlight power and the
//   background.

layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0) uniform sampler2D acc;
layout(rgba8, binding = 1) uniform writeonly image2D outimg;
layout(std430, binding = 5) readonly buffer Norm { float knorm[]; };

uniform ivec2 u_size;
uniform vec2 u_k;        // k1 = brightness * 268 / 256, k2 = ppu^2 / samples
uniform float u_gamma;   // 1 / gamma
uniform float u_vib;
uniform vec4 u_bg;
uniform vec4 u_de;       // cmax (radius + 1; 0 = off), cmin, curve, unused
uniform float u_highlight;
uniform float u_lin;     // gamma threshold

#define R 12
#define T (16 + 2 * R)
shared vec4 sv[T * T];
shared float sh[T * T];

// flam3_create_de_filters: kernel k has width cmax / (k + 1)^curve; past 100
// hits the kernels are spaced by (hits - 100)^curve
float kernel_width(float f) {
    float k;
    if (f <= 100.0) {
        k = ceil(f) - 1.0;
    } else {
        k = pow(floor(pow(f - 100.0, u_de.z)), 1.0 / u_de.z) + 100.0;
    }
    return max(u_de.x / pow(k + 1.0, u_de.z), u_de.y);
}

// rgb (average palette colour * t) and t of a pixel
vec4 tone_value(ivec2 p) {
    if (p.x < 0 || p.y < 0 || p.x >= u_size.x || p.y >= u_size.y) return vec4(0.0);
    vec4 a = texelFetch(acc, p, 0);
    if (a.w <= 0.0) return vec4(0.0);
    float t = u_k.x * log(1.0 + a.w * u_k.y);
    return vec4(a.rgb / (255.0 * a.w) * t, t);
}

vec3 rgb2hsv(vec3 c) {
    float mx = max(c.r, max(c.g, c.b)), mn = min(c.r, min(c.g, c.b));
    float d = mx - mn;
    float s = mx != 0.0 ? d / mx : 0.0;
    float h = 0.0;
    if (s != 0.0) {
        vec3 q = (vec3(mx) - c) / d;
        h = c.r == mx ? q.b - q.g : (c.g == mx ? 2.0 + q.r - q.b : 4.0 + q.g - q.r);
        if (h < 0.0) h += 6.0;
    }
    return vec3(h, s, mx);
}

vec3 hsv2rgb(vec3 c) {
    float h = mod(c.x, 6.0), s = c.y, v = c.z;
    float j = floor(h), f = h - j;
    float p = v * (1.0 - s), q = v * (1.0 - s * f), t = v * (1.0 - s * (1.0 - f));
    if (j < 1.0) return vec3(v, t, p);
    if (j < 2.0) return vec3(q, v, p);
    if (j < 3.0) return vec3(p, v, t);
    if (j < 4.0) return vec3(p, q, v);
    if (j < 5.0) return vec3(t, p, v);
    return vec3(v, p, q);
}

void main() {
    ivec2 base = ivec2(gl_WorkGroupID.xy) * 16 - R;
    bool de = u_de.x > 0.0;
    if (de) {
        uint li = gl_LocalInvocationIndex;
        for (uint i = li; i < uint(T * T); i += 256u) {
            ivec2 q = base + ivec2(int(i) % T, int(i) / T);
            vec4 v = tone_value(q);
            float h = 0.0;
            if (v.w > 0.0) {
                float f = texelFetch(acc, q, 0).w;
                h = kernel_width(f);
                v /= knorm[min(int(h * 16.0 + 0.5), 511)];
            }
            sv[i] = v;
            sh[i] = h;
        }
        barrier();
    }
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= u_size.x || p.y >= u_size.y) return;
    vec4 c = vec4(0.0);
    if (de) {
        ivec2 l = ivec2(gl_LocalInvocationID.xy) + R;
        // the widest kernel reaches ceil(cmax) - 1 pixels
        int reach = min(int(ceil(u_de.x)) - 1, R);
        for (int dy = -reach; dy <= reach; dy++) {
            int row = (l.y + dy) * T + l.x;
            for (int dx = -reach; dx <= reach; dx++) {
                int i = row + dx;
                float h = sh[i];
                float d2 = float(dx * dx + dy * dy);
                float reach = ceil(h) - 1.0;
                if (h > 0.0 && d2 <= h * h && float(max(abs(dx), abs(dy))) <= reach) {
                    // gauss(1.5 d / h) = e^(-2 (1.5 d / h)^2)
                    c += sv[i] * exp(-4.5 * d2 / (h * h));
                }
            }
        }
    } else {
        c = tone_value(p);
    }
    vec3 rgb = vec3(0.0);
    float t = c.w;
    float alpha = 0.0;
    if (t > 0.0) {
        alpha = t < u_lin ? (1.0 - t / u_lin) * t * pow(u_lin, u_gamma) / u_lin + (t / u_lin) * pow(t, u_gamma)
                          : pow(t, u_gamma);
        float ls = u_vib * 256.0 * alpha / t;
        // flam3_calc_newrgb
        vec3 cb = c.rgb;
        float maxa = -1.0, maxc = 0.0;
        for (int i = 0; i < 3; i++) {
            float a = ls * cb[i];
            if (a > maxa) { maxa = a; maxc = cb[i]; }
        }
        if (maxc > 0.0) {
            float newls = 255.0 / maxc;
            if (maxa > 255.0 && u_highlight >= 0.0) {
                vec3 hsv = rgb2hsv(newls * cb / 255.0);
                hsv.y *= pow(newls / ls, u_highlight);
                rgb = hsv2rgb(hsv) * 255.0;
            } else {
                float adj = maxa <= 255.0 ? 1.0 : min(-u_highlight, 1.0);
                rgb = ((1.0 - adj) * newls + adj * ls) * cb;
            }
        }
        rgb += (1.0 - u_vib) * 256.0 * pow(max(cb, vec3(0.0)), vec3(u_gamma));
    }
    rgb += (1.0 - clamp(alpha, 0.0, 1.0)) * u_bg.rgb * 256.0;
    imageStore(outimg, p, vec4(clamp(rgb / 255.0, 0.0, 1.0), 1.0));
}
